{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `src/api-types.d.ts` is generated from `contract/openapi.json` by
    // `api-types:generate` and is not committed. The vendored contract itself
    // IS formatted here like everything else - `api-contract:refresh` runs
    // biome over it after writing, so a refresh never leaves this red.
    //
    // `scripts/next-report/payloads/` is the cross-repository interface with
    // wego-ai, which tests its writer against the same files byte for byte. They
    // are not this repository's to reformat, and `malformed.json` is invalid on
    // purpose.
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!src/api-types.d.ts",
      "!scripts/next-report/payloads"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // stdout is a machine contract: `wego` prints JSON and nothing else, so
      // no module below the entrypoint may write to a stream directly. Every
      // human-facing line goes through the entrypoint (src/index.ts) or the
      // test suite. This built-in rule replaces the retired
      // biome-rules/cli-no-console.grit plugin and is broader: it disallows
      // every console method, not just log/error/warn/info/debug/trace.
      "includes": ["src/**", "!src/index.ts", "!**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    }
  ]
}
