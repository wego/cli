{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `contract/` holds the API's published document, vendored verbatim by
    // `api-contract:refresh`. Formatting it would rewrite every refresh into a
    // second, unreviewable diff, and leave `bun run lint` red until someone ran
    // `bun run format`. `src/api-types.d.ts` is generated from that document
    // and stays listed for the same reason.
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!contract",
      "!src/api-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // stdout is a machine contract: `wego` prints JSON and nothing else, so
      // no module below the entrypoint may write to a stream directly. Every
      // human-facing line goes through the entrypoint (src/index.ts) or the
      // test suite. This built-in rule replaces the retired
      // biome-rules/cli-no-console.grit plugin and is broader: it disallows
      // every console method, not just log/error/warn/info/debug/trace.
      "includes": ["src/**", "!src/index.ts", "!**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    }
  ]
}
