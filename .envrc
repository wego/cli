# Dev golden path for the `wego` CLI (opt-in, via direnv).
#
# Puts the live-source CLI on PATH while you are inside the repo: `wego` resolves
# to .bin/wego → src/index.ts, run through its `#!/usr/bin/env bun` shebang, so
# it executes the TypeScript directly with no compile step (`wego version` prints
# 0.0.0-dev). PATH_add PREPENDS, so this shadows any installed `wego` while you
# are here; direnv restores your prior PATH verbatim on `cd` out, so an installed
# binary (or "not found") comes back untouched.
#
# Scoped to the current shell, reverted on leave, and per-worktree correct
# (PATH_add resolves relative to THIS .envrc, so each worktree gets its own
# source). Requires direnv installed + a one-time `direnv allow`; without direnv
# this file is inert. Baseline fallback without direnv: `bun link`.
#
# Paths are repo-root-relative here; in wego-ai they were apps/cli-prefixed.
PATH_add .bin

# Load the CLI's env from any cwd, not just the repo root. Bun auto-loads
# .env.local only from the directory a script runs in, so `wego` invoked from a
# subdirectory would start without its required public endpoint/client
# configuration. Sourcing it here exports the CLI's (public, PKCE — no secret)
# OAuth config into the shell so `wego` is fully configured from ANY cwd.
# dotenv_if_exists no-ops when the file is absent (e.g. before
# `cp .env.local.example .env.local`), leaving that fail-fast intact.
dotenv_if_exists .env.local
